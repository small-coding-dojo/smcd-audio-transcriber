# Copy this file to `.env` and adjust as needed.
# All values have sensible defaults if left unset - this file just documents them.

APP_NAME=ClearVoice Audio Transcriber Service
LOG_LEVEL=INFO

# --- Transcription model configuration (used from Phase 1 onward) ---
WHISPER_MODEL_SIZE=base
DEVICE=cpu
COMPUTE_TYPE=int8

# --- Concurrency (used from Phase 5 onward) ---
MAX_CONCURRENT_JOBS=2

# --- Upload limits (used from Phase 1/3 onward) ---
MAX_UPLOAD_SIZE_MB=100
MAX_AUDIO_DURATION_SECONDS=1800

# --- Diarisation (used from Phase 2 onward) ---
# HuggingFace token for pyannote.audio's pretrained pipelines. Leave blank for
# now. Never commit a real token - supply via env/secret store only.
HUGGINGFACE_TOKEN=

# --- Model download & caching (see README) ---
# Directory models are expected to be pre-baked into at container build time.
MODEL_CACHE_DIR=/models
